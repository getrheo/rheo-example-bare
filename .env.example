# @rheo/example-bare — copy to apps/example-bare/.env
# Values are inlined at Metro transform time (see babel.config.js).

# Optional — Superwall public API keys (lib/superwallBootstrap.ts).
# Prefer platform keys; SUPERWALL_API_KEY / EXPO_PUBLIC_SUPERWALL_API_KEY are shared fallbacks.
# SUPERWALL_IOS_API_KEY=pk_...
# SUPERWALL_ANDROID_API_KEY=pk_...
# SUPERWALL_API_KEY=pk_...
# EXPO_PUBLIC_SUPERWALL_IOS_API_KEY=pk_...
# EXPO_PUBLIC_SUPERWALL_ANDROID_API_KEY=pk_...
# EXPO_PUBLIC_SUPERWALL_API_KEY=pk_...
